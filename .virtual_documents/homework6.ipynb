arr3 = np.array([
    [2, 3, 5],
    [14, 6, 8],
    [11, 13, 17],
    [7, 10, 13]
])

def prime_return(arr):
    primes=[]
    for num in arr.flat:
        if num==2:
            continue
        is_prime=True
        for i in range (2, num):
            if num%i == 0:
                is_prime = False
                break
        if is_prime:
            primes.append(num)
    return np.array(primes)

print(prime_return(arr3))


def zeros_array(a,b):
    array = np.zeros((a,b),dtype=int)
    return array 
print(zeros_array(8,8))

print()

def board_array(a,b):
    array = np.zeros((a,b),dtype=int)
    array[::2, ::2]=1
    array[1::2, 1::2]=1
    return array 
print(board_array(8,8))

print()

def reverse_array(a,b):
    array = np.zeros((a,b),dtype=int)
    array[::2, 1::2]=1
    array[1::2, ::2]=1
    return array 
print(reverse_array(8,8))


universe = np.array(['galaxy','clusters'])

def big_bang(array,spaces):
    seperator = ' ' * spaces
    return np.char.join(seperator, array)    

print(big_bang(universe,3))



star_array = np.array([[1123, 1456, 1789, 1324, 1876],
[1567, 1987, 1678, 1405, 1589],
[1345, 1654, 1523, 1109, 1923],
[1298, 1890, 1367, 1784, 1432],
[1823, 1756, 1489, 1672, 1550]])

def second_brightest(array):
    second_largest=np.sort(array, axis=1)[:, -2]
    return second_largest

print(second_brightest(star_array))


